---
import { Image } from 'astro:assets';
import perimeterSiteImage from '../../assets/images/portable-toilet-perimeter-site.jpeg';
import ruralSiteImage from '../../assets/images/portable-toilet-rural-site.jpeg';
import residentialSiteImage from '../../assets/images/portable-toilets-residential-site.jpeg';
import sportsSiteImage from '../../assets/images/portable-toilets-sports-site.jpeg';
import urbanSiteImage from '../../assets/images/portable-toilets-urban-site.jpeg';
import Section from '../common/section.astro';

/**
 * @description Defines the approved field photographs and the context each contributes.
 */
const galleryItems = [
  {
    image: ruralSiteImage,
    alt: 'Baño químico instalado en un proyecto rural',
    position: 'centre',
    layout: 'tall-start',
  },
  {
    image: sportsSiteImage,
    alt: 'Cuatro baños químicos instalados junto a un campo deportivo',
    position: 'centre',
    layout: 'wide-top',
  },
  {
    image: urbanSiteImage,
    alt: 'Dos baños químicos instalados en un entorno urbano',
    position: 'centre',
    layout: 'tall-end',
  },
  {
    image: residentialSiteImage,
    alt: 'Dos baños químicos instalados en un espacio residencial arbolado',
    position: 'upper',
    layout: 'wide-middle',
  },
  {
    image: perimeterSiteImage,
    alt: 'Baño químico instalado junto al perímetro de un proyecto abierto',
    position: 'upper',
    layout: 'wide-bottom',
  },
] as const;
---

<Section id="experiencia" labelledBy="gallery-heading" tone="subtle">
  <div class="gallery-header">
    <p class="eyebrow">Experiencia en campo</p>
    <h2 id="gallery-heading">Instalaciones reales en distintos contextos.</h2>
    <p>
      Cada proyecto plantea condiciones diferentes para la ubicación y el
      cuidado de las unidades.
    </p>
  </div>

  <div class="gallery-grid">
    {
      galleryItems.map(({ image, alt, position, layout }) => (
        <figure class:list={['gallery-item', `gallery-item-${layout}`]}>
          <Image
            class:list={['gallery-image', `gallery-image-${position}`]}
            src={image}
            alt={alt}
            format="webp"
            quality={80}
            widths={[360, 560, 720]}
            sizes="(min-width: 64rem) 23rem, (min-width: 40rem) 45vw, 100vw"
            layout="constrained"
            loading="lazy"
          />
        </figure>
      ))
    }
  </div>
</Section>

<style>
  .gallery-header {
    max-width: 50rem;
    margin-block-end: var(--space-7);
  }

  .eyebrow {
    margin-block-end: var(--space-3);
    color: var(--colour-brand-teal);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 17ch;
    margin-block-end: var(--space-4);
    font-size: var(--font-size-heading-2);
  }

  .gallery-header > p:last-child {
    margin-block-end: 0;
    color: var(--colour-muted);
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-4);
    max-width: 68rem;
    grid-auto-flow: dense;
  }

  .gallery-item {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: var(--colour-border);
    border-radius: var(--radius-large);
    box-shadow: 0 0.75rem 1.75rem rgb(1 61 67 / 9%);
  }

  .gallery-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gallery-image-centre {
    object-position: center;
  }

  .gallery-image-upper {
    object-position: 50% 32%;
  }

  @media (width >= 40rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(3, clamp(12rem, 18vw, 14rem));
    }

    .gallery-item-tall-start {
      grid-area: 1 / 1 / span 2 / span 1;
    }

    .gallery-item-wide-top {
      grid-area: 1 / 2 / span 1 / span 2;
    }

    .gallery-item-tall-end {
      grid-area: 1 / 4 / span 2 / span 1;
    }

    .gallery-item-wide-middle {
      grid-area: 2 / 2 / span 1 / span 2;
    }

    .gallery-item-wide-bottom {
      grid-area: 3 / 2 / span 1 / span 2;
    }

    .gallery-image {
      height: 100%;
      aspect-ratio: auto;
    }
  }
</style>
