---
import { Image } from 'astro:assets';
import ruralSiteImage from '../../assets/images/portable-toilet-rural-site.jpeg';
import sportsSiteImage from '../../assets/images/portable-toilets-sports-site.jpeg';
import urbanSiteImage from '../../assets/images/portable-toilets-urban-site.jpeg';
import Section from '../common/section.astro';

/**
 * @description Defines the approved field photographs and the context each contributes.
 */
const galleryItems = [
  {
    image: ruralSiteImage,
    alt: 'Baño químico instalado en un proyecto rural',
    featured: true,
  },
  {
    image: sportsSiteImage,
    alt: 'Cuatro baños químicos instalados junto a un campo deportivo',
    featured: false,
  },
  {
    image: urbanSiteImage,
    alt: 'Dos baños químicos instalados en un entorno urbano',
    featured: false,
  },
] as const;
---

<Section id="experiencia" labelledBy="gallery-heading" tone="subtle">
  <div class="gallery-header">
    <p class="eyebrow">Experiencia en campo</p>
    <h2 id="gallery-heading">Instalaciones reales en distintos contextos.</h2>
    <p>
      Cada proyecto plantea condiciones diferentes para la ubicación y el
      cuidado de las unidades.
    </p>
  </div>

  <div class="gallery-grid">
    {
      galleryItems.map(({ image, alt, featured }) => (
        <figure
          class:list={['gallery-item', { 'gallery-item-featured': featured }]}
        >
          <Image
            class="gallery-image"
            src={image}
            alt={alt}
            format="webp"
            quality={80}
            widths={[480, 720]}
            sizes={
              featured
                ? '(min-width: 52rem) 46vw, 100vw'
                : '(min-width: 52rem) 38vw, 100vw'
            }
            layout="constrained"
            loading="lazy"
          />
        </figure>
      ))
    }
  </div>
</Section>

<style>
  .gallery-header {
    max-width: 50rem;
    margin-block-end: var(--space-7);
  }

  .eyebrow {
    margin-block-end: var(--space-3);
    color: var(--colour-brand-teal);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 17ch;
    margin-block-end: var(--space-4);
    font-size: var(--font-size-heading-2);
  }

  .gallery-header > p:last-child {
    margin-block-end: 0;
    color: var(--colour-muted);
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-4);
  }

  .gallery-item {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: var(--colour-border);
    border-radius: var(--radius-large);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    min-height: 18rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gallery-item-featured .gallery-image {
    object-position: 50% 45%;
  }

  @media (width >= 52rem) {
    .gallery-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
      grid-template-rows: repeat(2, minmax(14rem, 1fr));
    }

    .gallery-item-featured {
      grid-row: span 2;
    }

    .gallery-image {
      min-height: 0;
      aspect-ratio: auto;
    }
  }
</style>
