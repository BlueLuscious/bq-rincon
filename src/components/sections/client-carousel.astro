---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ChevronLeft, ChevronRight, Pause, Play } from '@lucide/astro';
import { CLIENT_CAROUSEL_DEFAULT_RESUME_DELAY_MS } from '../../scripts/client-carousel.controller';
import IconButton from '../common/icon-button.astro';

/**
 * @description Defines the public inputs accepted by the continuous client carousel.
 */
interface Props {
  /** @description Provides a stable identifier used by the carousel controls. */
  id: string;
  /** @description Provides ordered, approved client references and optional logos. */
  clients: readonly {
    /** @description Provides the accessible organisation name represented by the slide. */
    readonly name: string;
    /** @description Provides optional approved artwork for the organisation. */
    readonly logo?: ImageMetadata;
    /** @description Selects the card surface required by the supplied artwork. */
    readonly tone?: 'default' | 'inverse';
    /** @description Requests a square card for visually compact artwork. */
    readonly compact?: boolean;
  }[];
  /** @description Sets continuous movement speed in CSS pixels per second. */
  speed?: number;
  /** @description Exposes native horizontal scrolling and its scrollbar when requested. */
  showScrollbar?: boolean;
  /** @description Controls whether optional previous and next buttons are rendered. */
  showArrows?: boolean;
  /** @description Sets the delay before automatic movement resumes after arrow navigation. */
  manualResumeDelay?: number;
}

/**
 * @description Provides the carousel configuration forwarded to static markup and behaviour.
 */
const {
  id,
  clients,
  speed = 22,
  showScrollbar = false,
  showArrows = true,
  manualResumeDelay = CLIENT_CAROUSEL_DEFAULT_RESUME_DELAY_MS,
} = Astro.props;

/**
 * @description Identifies the viewport controlled by the carousel toolbar.
 */
const viewportId = `${id}-viewport`;

/**
 * @description Provides one semantic sequence and one concealed visual continuation.
 */
const sequences = [false, true] as const;
---

<div
  class="client-carousel"
  data-client-carousel
  data-carousel-speed={speed}
  data-carousel-resume-delay={manualResumeDelay}
  role="region"
  aria-roledescription="carrusel"
  aria-label="Clientes de BQ Baños Químicos"
>
  <div class="carousel-toolbar">
    <div data-carousel-action="rotation">
      <IconButton
        label="Pausar movimiento automático"
        controls={viewportId}
        pressed={false}
      >
        <Pause size={20} aria-hidden="true" />
        <Play size={20} slot="pressed-icon" aria-hidden="true" />
      </IconButton>
    </div>

    {
      showArrows && (
        <div class="carousel-navigation" aria-label="Controles del carrusel">
          <div data-carousel-action="previous">
            <IconButton
              label="Mostrar clientes anteriores"
              controls={viewportId}
            >
              <ChevronLeft size={22} aria-hidden="true" />
            </IconButton>
          </div>
          <div data-carousel-action="next">
            <IconButton
              label="Mostrar clientes siguientes"
              controls={viewportId}
            >
              <ChevronRight size={22} aria-hidden="true" />
            </IconButton>
          </div>
        </div>
      )
    }
  </div>

  <div
    id={viewportId}
    class:list={[
      'carousel-viewport',
      { 'carousel-viewport-scrollable': showScrollbar },
    ]}
    data-carousel-viewport
    tabindex={showScrollbar ? 0 : undefined}
    aria-label="Referencias de clientes"
    aria-live="off"
  >
    <div class="carousel-track" data-carousel-track>
      {
        sequences.map((clone) => (
          <div
            class="carousel-sequence"
            data-carousel-sequence
            data-carousel-clone={clone ? '' : undefined}
            aria-hidden={clone ? 'true' : undefined}
            inert={clone ? true : undefined}
          >
            {clients.map(
              ({ name, logo, tone = 'default', compact = false }, index) => (
                <div
                  class:list={[
                    'client-slide',
                    `client-slide-${tone}`,
                    {
                      'client-slide-logo': logo,
                      'client-slide-compact': compact,
                    },
                  ]}
                  data-carousel-slide
                  role={clone ? undefined : 'group'}
                  aria-roledescription={clone ? undefined : 'diapositiva'}
                  aria-label={
                    clone
                      ? undefined
                      : `${index + 1} de ${clients.length}: ${name}`
                  }
                >
                  {logo ? (
                    <Image
                      class="client-logo"
                      src={logo}
                      alt=""
                      widths={[160, 240, 320]}
                      sizes="(min-width: 64rem) 14rem, 11rem"
                      format={logo.format === 'svg' ? 'svg' : 'webp'}
                      quality={90}
                      loading="lazy"
                      draggable="false"
                    />
                  ) : (
                    <span>{name}</span>
                  )}
                </div>
              ),
            )}
          </div>
        ))
      }
    </div>
  </div>

  <p
    class="carousel-status"
    data-carousel-status
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
  </p>
</div>

<script>
  import { initialiseClientCarousel } from '../../scripts/client-carousel.controller';

  initialiseClientCarousel();
</script>

<style>
  .client-carousel {
    display: grid;
    gap: var(--space-4);
  }

  .carousel-toolbar,
  .carousel-navigation {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .carousel-toolbar {
    justify-content: space-between;
  }

  .carousel-viewport {
    overflow: hidden;
    overscroll-behavior-inline: contain;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  .carousel-viewport[data-carousel-dragging] {
    cursor: grabbing;
  }

  .carousel-viewport-scrollable {
    overflow-x: auto;
    scrollbar-color: var(--colour-brand-teal) var(--colour-background);
    scrollbar-width: thin;
  }

  .carousel-track,
  .carousel-sequence {
    display: flex;
    gap: var(--space-3);
    width: max-content;
  }

  .client-slide {
    display: grid;
    flex: 0 0 clamp(15rem, 24vw, 19rem);
    min-width: 0;
    min-height: 8.75rem;
    padding: var(--space-5);
    color: var(--colour-ink);
    font-weight: var(--font-weight-bold);
    text-align: center;
    background: var(--gradient-sanitation-surface);
    border: 0.0625rem solid var(--colour-border);
    border-radius: var(--radius-medium);
    place-items: center;
  }

  .client-slide-logo {
    background: var(--colour-surface);
  }

  .client-slide-compact {
    flex-basis: 8.75rem;
    min-height: 8.75rem;
    padding: var(--space-4);
    aspect-ratio: 1;
  }

  .client-slide-inverse {
    background: var(--colour-shadow);
    border-color: var(--colour-shadow);
  }

  .client-logo {
    width: auto;
    max-width: min(100%, 15rem);
    height: auto;
    max-height: 5.25rem;
    object-fit: contain;
  }

  .client-slide-compact .client-logo {
    max-width: 7rem;
    max-height: 7rem;
  }

  .carousel-status {
    position: absolute;
    width: 0.0625rem;
    height: 0.0625rem;
    padding: 0;
    margin: -0.0625rem;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip-path: inset(50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-viewport {
      scroll-behavior: auto;
    }
  }
</style>
