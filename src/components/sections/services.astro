---
import {
  PackagePlus,
  Sparkles,
  SprayCan,
  Toilet,
  Truck,
  Wrench,
} from '@lucide/astro';
import Section from '../common/section.astro';

/**
 * @description Defines the approved service categories and their customer-facing summaries.
 */
const services = [
  {
    icon: Toilet,
    title: 'Alquiler de unidades',
    description:
      'Baños químicos para necesidades temporales en obras, industrias y proyectos.',
  },
  {
    icon: Truck,
    title: 'Traslado e instalación',
    description:
      'Entrega y ubicación de las unidades en el espacio coordinado para cada operación.',
  },
  {
    icon: Sparkles,
    title: 'Limpieza programada',
    description:
      'Visitas de limpieza coordinadas según las condiciones acordadas para el servicio.',
  },
  {
    icon: SprayCan,
    title: 'Desagote y sanitización',
    description:
      'Tratamiento integral de las unidades para sostener condiciones adecuadas de higiene.',
  },
  {
    icon: PackagePlus,
    title: 'Reposición de insumos',
    description:
      'Reabastecimiento de los consumibles de higiene contemplados en cada servicio.',
  },
  {
    icon: Wrench,
    title: 'Mantenimiento',
    description:
      'Atención preventiva y correctiva para conservar las unidades en condiciones de uso.',
  },
] as const;
---

<Section id="servicios" labelledBy="services-heading">
  <div class="section-introduction">
    <p class="eyebrow">Servicios</p>
    <h2 id="services-heading">Una solución integral en cada etapa.</h2>
    <p class="section-summary">
      Coordinamos las unidades y las tareas necesarias para acompañar las
      condiciones de cada proyecto.
    </p>
  </div>

  <ol class="service-grid">
    {
      services.map(({ icon: Icon, title, description }) => (
        <li class="service-card">
          <span class="service-icon" aria-hidden="true">
            <Icon stroke-width={1.8} />
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .section-introduction {
    display: grid;
    max-width: 58rem;
    margin-block-end: var(--space-7);
  }

  .eyebrow {
    margin-block-end: var(--space-3);
    color: var(--colour-brand-teal);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    width: var(--width-heading-2-section);
    margin-block-end: var(--space-4);
    font-size: var(--font-size-heading-2-section);
  }

  .section-summary {
    max-width: 48rem;
    margin-block-end: 0;
    color: var(--colour-muted);
  }

  .service-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .service-card {
    min-height: 15rem;
    padding: var(--space-6);
    background: var(--gradient-sanitation-surface);
    border: 0.0625rem solid var(--colour-border);
    border-radius: var(--radius-medium);
    box-shadow: 0 0.75rem 2rem rgb(1 61 67 / 6%);
    transition:
      box-shadow var(--motion-duration-base) var(--motion-easing-standard),
      transform var(--motion-duration-base) var(--motion-easing-standard);
  }

  .service-icon {
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    margin-block-end: var(--space-6);
    color: var(--colour-on-brand);
    background: var(--gradient-sanitation-accent);
    border-radius: var(--radius-medium);
    box-shadow: 0 0.5rem 1rem rgb(1 61 67 / 15%);
    place-items: center;
  }

  h3 {
    margin-block-end: var(--space-3);
    font-size: 1.25rem;
  }

  .service-card p {
    margin-block-end: 0;
    color: var(--colour-muted);
    font-size: 0.9375rem;
  }

  @media (hover: hover) {
    .service-card:hover {
      box-shadow: var(--shadow-medium);
      transform: translateY(-0.25rem);
    }
  }

  @media (width >= 40rem) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .service-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
