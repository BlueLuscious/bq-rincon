---
import { Image } from 'astro:assets';
import {
  ExternalLink,
  Mail,
  MapPin,
  MessageCircle,
  Phone,
} from '@lucide/astro';
import brandMark from '../../assets/brand/bq-mark-primary.svg';
import quinotoLogo from '../../assets/partners/quinoto-logo-positive.png';
import Container from '../common/container.astro';

/**
 * @description Provides the current year for the site ownership notice.
 */
const currentYear = new Date().getFullYear();

/**
 * @description Provides the approved public Instagram destination.
 */
const instagramUrl = 'https://www.instagram.com/bqrincon?igsh=c2dtbmV2d2FkYjVo';

/**
 * @description Opens the approved Villa Constitución operating-base address in Google Maps.
 */
const villaConstitucionMapUrl =
  'https://www.google.com/maps/search/?api=1&query=Urquiza%201538%2C%20Villa%20Constituci%C3%B3n%2C%20Santa%20Fe';

/**
 * @description Opens the approved Rincón de los Sauces operating-base address in Google Maps.
 */
const rinconDeLosSaucesMapUrl =
  'https://www.google.com/maps?q=Trapial+%26+Primeros+Pobladores+Oeste,+Q8319+Rinc%C3%B3n+de+los+Sauces,+Neuqu%C3%A9n&ftid=0x967380194c903f95:0x2fdf806879d3f2dd';
---

<footer class="site-footer">
  <Container>
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <img src={brandMark.src} alt="" width={64} height={64} loading="lazy" />
        <div>
          <strong>BQ Baños Químicos</strong>
          <p>Soluciones sanitarias para obras, industrias y proyectos.</p>
          <p class="site-footer-principles">
            Higiene, seguridad y atención personalizada en cada servicio.
          </p>
        </div>
      </div>

      <section class="footer-column" aria-labelledby="footer-contact-heading">
        <h2 id="footer-contact-heading">Contacto</h2>
        <ul class="footer-list">
          <li>
            <Phone size={19} aria-hidden="true" />
            <span>
              <span class="footer-label">Teléfonos</span>
              <a href="tel:+543400415140">3400 415140</a>
              <a href="tel:+543400441365">3400 441365</a>
            </span>
          </li>
          <li>
            <MessageCircle size={19} aria-hidden="true" />
            <span>
              <span class="footer-label">WhatsApp</span>
              <a href="https://wa.me/5493400415140">3400 415140</a>
              <a href="https://wa.me/5493400441365">3400 441365</a>
            </span>
          </li>
          <li>
            <Mail size={19} aria-hidden="true" />
            <span>
              <span class="footer-label">Correo electrónico</span>
              <a href="mailto:infobqrincon@gmail.com">
                infobqrincon@gmail.com
              </a>
            </span>
          </li>
          <li>
            <ExternalLink size={19} aria-hidden="true" />
            <span>
              <span class="footer-label">Instagram</span>
              <a href={instagramUrl} target="_blank" rel="noreferrer">
                @bqrincon
              </a>
            </span>
          </li>
        </ul>
      </section>

      <section class="footer-column" aria-labelledby="footer-location-heading">
        <h2 id="footer-location-heading">Ubicaciones</h2>
        <ul class="footer-list">
          <li>
            <MapPin size={19} aria-hidden="true" />
            <address>
              <a
                class="location-link"
                href={villaConstitucionMapUrl}
                target="_blank"
                rel="noreferrer"
                aria-label="Ver Urquiza 1538, Villa Constitución, Santa Fe en Google Maps"
              >
                <span>Urquiza 1538<br />Villa Constitución, Santa Fe</span>
                <span class="location-link-action">
                  Ver en Google Maps
                  <ExternalLink size={14} aria-hidden="true" />
                </span>
              </a>
            </address>
          </li>
          <li>
            <MapPin size={19} aria-hidden="true" />
            <address>
              <a
                class="location-link"
                href={rinconDeLosSaucesMapUrl}
                target="_blank"
                rel="noreferrer"
                aria-label="Ver Trapial y Primeros Pobladores Oeste, Rincón de los Sauces, Neuquén en Google Maps"
              >
                <span>
                  Trapial y Primeros Pobladores Oeste<br />Rincón de los Sauces,
                  Neuquén
                </span>
                <span class="location-link-action">
                  Ver en Google Maps
                  <ExternalLink size={14} aria-hidden="true" />
                </span>
              </a>
            </address>
          </li>
        </ul>
      </section>
    </div>

    <div class="site-footer-legal">
      <p class="site-footer-copyright">
        © {currentYear} BQ Baños Químicos. María Verónica Marinelli · CUIT 27-23047157-1.
      </p>
      <a
        class="site-footer-credit"
        href="https://quinoto.com.ar/"
        target="_blank"
        rel="noreferrer"
        aria-label="Visitar el sitio web de Quinoto"
      >
        <span>Developed by Quinoto</span>
        <Image
          src={quinotoLogo}
          alt=""
          width={44}
          height={44}
          format="webp"
          quality={90}
          loading="lazy"
        />
      </a>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7)
      calc(var(--space-8) + var(--space-2) + env(safe-area-inset-bottom));
    color: var(--colour-on-brand);
    background: var(--colour-shadow);
    border-block-start: 0.25rem solid var(--colour-brand-orange);
  }

  .site-footer-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 1.15fr) repeat(
        2,
        minmax(13rem, 0.85fr)
      );
    gap: var(--space-7);
  }

  .site-footer-brand {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .site-footer-brand img {
    flex: 0 0 auto;
    width: 4rem;
    height: 4rem;
    padding: var(--space-1);
    background: var(--colour-surface);
    border-radius: var(--radius-medium);
  }

  .site-footer-brand strong {
    display: block;
    margin-block-end: var(--space-2);
    font-size: 1.125rem;
  }

  .site-footer-brand p,
  .site-footer-copyright {
    margin-block-end: 0;
    color: var(--colour-on-dark-muted);
    font-size: 0.875rem;
  }

  .site-footer-principles {
    max-width: 28rem;
    padding-block-start: var(--space-4);
    margin-block-start: var(--space-4);
    border-block-start: 0.0625rem solid rgb(209 220 222 / 24%);
  }

  .footer-column h2 {
    margin-block-end: var(--space-4);
    color: var(--colour-on-brand);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  .footer-list li > svg {
    margin-block-start: 0.2rem;
    color: var(--colour-brand-orange);
  }

  .footer-list li > span {
    display: grid;
    justify-items: start;
  }

  .footer-label {
    color: var(--colour-on-dark-muted);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-list a,
  .footer-list address {
    color: var(--colour-on-brand);
    font-size: 0.9375rem;
    font-style: normal;
  }

  .footer-list a {
    overflow-wrap: anywhere;
  }

  .location-link {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
  }

  .location-link-action {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    color: var(--colour-on-dark-muted);
    font-size: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .site-footer-legal {
    display: grid;
    gap: var(--space-4);
    place-items: center;
    padding-block-start: var(--space-5);
    margin-block-start: var(--space-7);
    border-block-start: 0.0625rem solid rgb(209 220 222 / 24%);
  }

  .site-footer-credit {
    display: inline-flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--colour-on-brand);
    font-size: 0.875rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-decoration: none;
  }

  .site-footer-credit img {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    border-radius: var(--radius-small);
    transition: transform var(--transition-duration) ease;
  }

  .site-footer-credit:hover img {
    transform: translateY(-0.125rem);
  }

  .site-footer-copyright {
    text-align: center;
  }

  @media (width >= 40rem) {
    .site-footer-legal {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-6);
      place-items: center stretch;
    }

    .site-footer-copyright {
      text-align: start;
    }

    .site-footer-credit {
      justify-self: end;
    }
  }

  @media (width < 64rem) {
    .site-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (width < 40rem) {
    .site-footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-footer-brand {
      grid-column: auto;
    }
  }
</style>
