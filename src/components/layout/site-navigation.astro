---
import { Menu, X } from '@lucide/astro';
import IconButton from '../common/icon-button.astro';

/**
 * @description Defines the stable destinations exposed by the primary site navigation.
 */
const navigationItems = [
  { href: '#clientes', label: 'Clientes' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#como-trabajamos', label: 'Cómo trabajamos' },
  { href: '#seguridad', label: 'Seguridad' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#experiencia', label: 'Experiencia' },
] as const;
---

<div class="site-navigation" data-site-navigation>
  <div class="navigation-toggle">
    <IconButton
      id="site-navigation-toggle"
      label="Abrir navegación"
      controls="site-navigation-panel"
      expanded={false}
    >
      <Menu size={22} aria-hidden="true" />
      <X size={22} slot="expanded-icon" aria-hidden="true" />
    </IconButton>
  </div>

  <nav
    id="site-navigation-panel"
    class="navigation-panel"
    aria-label="Navegación principal"
  >
    <ul class="navigation-list">
      {
        navigationItems.map(({ href, label }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  import { initialiseNavigationDisclosure } from '../../scripts/navigation-disclosure.controller';
  import { initialiseSectionNavigationController } from '../../scripts/section-navigation.controller';

  initialiseNavigationDisclosure();
  initialiseSectionNavigationController();
</script>

<style>
  .site-navigation {
    display: flex;
    justify-content: flex-end;
  }

  .navigation-toggle {
    display: none;
  }

  .navigation-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    padding-block: var(--space-2);
    color: var(--colour-ink);
    font-size: 0.875rem;
    font-weight: var(--font-weight-medium);
    text-decoration-color: transparent;
    transition:
      color var(--transition-duration) ease,
      text-decoration-color var(--transition-duration) ease;
  }

  a:hover,
  a[aria-current='location'] {
    color: var(--colour-brand-teal);
    text-decoration-color: currentcolor;
  }

  a[aria-current='location'] {
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.35em;
  }

  a:active {
    color: var(--colour-brand-orange-dark);
  }

  @media (width < 64rem) {
    .navigation-list {
      justify-content: flex-end;
      gap: var(--space-1) var(--space-4);
    }

    .site-navigation[data-navigation-ready] .navigation-toggle {
      display: block;
    }

    .site-navigation[data-navigation-ready] .navigation-panel {
      position: absolute;
      inset-block-start: calc(100% + var(--space-2));
      inset-inline-end: 0;
      width: min(20rem, calc(100vw - (2 * var(--container-inline-space))));
      max-height: calc(100vh - var(--site-header-height) - var(--space-5));
      padding: var(--space-2);
      overflow-y: auto;
      background: var(--colour-surface);
      border: 0.0625rem solid var(--colour-border);
      border-radius: var(--radius-medium);
      box-shadow: var(--shadow-medium);
    }

    .site-navigation[data-navigation-ready] .navigation-list {
      display: grid;
      width: 100%;
      gap: 0;
      justify-content: stretch;
    }

    .site-navigation[data-navigation-ready] a {
      justify-content: flex-start;
      width: 100%;
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-small);
    }

    .site-navigation[data-navigation-ready] a:hover {
      background: var(--colour-surface-subtle);
    }

    .site-navigation[data-navigation-ready] a[aria-current='location'] {
      background: var(--gradient-sanitation-surface);
    }
  }
</style>
